{
  "name": "gitlab-artifacts",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "Prepare an approved GitLab job artifact for simulator installation",
  "icon": "document",
  "capabilities": ["apps"],
  "contributes": {
    "commands": [
      {
        "id": "install",
        "title": "Install GitLab artifact",
        "run": ["python3", "bin/download.py"],
        "background": {
          "timeoutSeconds": 3600,
          "environment": ["GITLAB_TOKEN", "GITLAB_HOST", "HOME"]
        }
      }
    ],
    "panels": [
      {
        "id": "install",
        "title": "GitLab Install",
        "icon": "document",
        "when": "simulator.booted",
        "body": {
          "kind": "list",
          "source": "install",
          "prompt": {
            "arg": "url",
            "placeholder": "https://gitlab.example.com/group/project/-/jobs/123",
            "submit": "Install"
          }
        }
      }
    ]
  }
}
